# Upstream provides the locked Python environment and the release-stamped
# holmes/__init__.py. All agent source is taken from this checkout.
FROM robustadev/holmes:0.46.0@sha256:bec9d14eea6a8890ba498c91ab47adcce3af9b6d0c6ee26d642d4e3e0df6218e
WORKDIR /app
COPY holmes/ /app/holmes/
COPY server.py holmes_cli.py /app/
ARG VCS_REF
LABEL org.opencontainers.image.source="https://github.com/hainingning/holmesgpt" \
      org.opencontainers.image.version="0.46.0-mimi.1" \
      org.opencontainers.image.revision="${VCS_REF}"
